{
  // Gemini CLI settings.
  "theme": "GitHub",
  "mcpServers": {
    "docs": {
      "command": "npx",
      "args": ["-y", "docs-mcp"],
      "trust": false
    },
    "origincloud": {
      "command": "origin",
      "args": ["mcp", "serve", "--toolsets", "pvs,location", "--read-only"]
    }
  },
  "general": {
    "vimMode": true,
  },
}
