{
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": ["@playwright/mcp@latest"],
      "tools": ["*"]
    },
    "docs": {
      "type": "http",
      "url": "https://docs.example.com/mcp",
      "headers": {}
    },
    "origincloud": {
      "type": "stdio",
      "command": "origin",
      "args": ["mcp", "serve", "--toolsets", "pvs,location", "--read-only"],
      "tools": ["*"]
    }
  }
}
