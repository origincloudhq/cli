{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "/Users/u/Desktop"]
    },
    "origincloud": {
      "command": "origin",
      "args": ["mcp", "serve", "--toolsets", "pvs,location", "--read-only"]
    }
  },
  "globalShortcut": "Ctrl+Space"
}
